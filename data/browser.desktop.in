[Desktop Entry]
Version=1.0
Type=Application
Name=@NAME@
GenericName=Web Browser
Comment=Browse the web with tiles, tabs and bubbles
Icon=@APP_ID@
Exec=singularity-browser %U
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;internet;browser;www;tabs;tiles;
StartupNotify=true
StartupWMClass=@APP_ID@
DBusActivatable=false
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=singularity-browser --new-window

[Desktop Action new-private-window]
Name=New Private Window
Icon=@APP_ID@-private-symbolic
Exec=singularity-browser --private
